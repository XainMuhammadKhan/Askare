{
  "expo": {
    "name": "AskCare",
    "slug": "AskareApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Images/logo_adaptive.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Images/logo_adaptive.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xain.k19.Askare",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "AskCare uses your camera for video consultations with your doctor and uploading medical reports.",
        "NSMicrophoneUsageDescription": "AskCare uses your microphone for audio during video consultations with your doctor.",
        "NSPhotoLibraryUsageDescription": "AskCare accesses your photo library so you can attach medical reports and prescriptions."
      }
    },
    "android": {
      "package": "com.xain.k19.Askare",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Images/logo_adaptive.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "41679ea3-ea38-475c-8258-921fa397abff"
      }
    }
  }
}
